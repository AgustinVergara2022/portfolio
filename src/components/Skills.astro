---
import Section from "./Section.astro";

const developmentSkills = [
  "Java",
  "Spring Boot",
  "Angular",
  "REST APIs",
  "MySQL",
  "PostgreSQL",
  "SQLite",
];

const devopsSkills = [
  "Docker",
  "Dockerfile",
  "Git",
  "GitHub",
  "Render",
  "Vercel",
  "Aiven",
];

const otherSkills = [
  "Postman",
  "Swagger",
  "Scrum",
];
---

<Section text="Tecnologías y herramientas" href="skills">
  <div class="space-y-10">

    <div>
      <h3 class="mb-4 font-serif text-2xl font-bold text-white">
        Desarrollo
      </h3>

      <div class="flex flex-wrap gap-3">
        {
          developmentSkills.map((skill) => (
            <span
              class="rounded-full border border-primary/50 bg-primary/10 px-5 py-2.5 text-sm font-medium text-primary transition hover:bg-primary/20"
            >
              {skill}
            </span>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="mb-4 font-serif text-2xl font-bold text-white">
        DevOps y despliegue
      </h3>

      <div class="flex flex-wrap gap-3">
        {
          devopsSkills.map((skill) => (
            <span
              class="rounded-full border border-neutral/20 bg-[#1c232d]/60 px-5 py-2.5 text-sm font-medium text-white transition hover:border-primary hover:text-primary"
            >
              {skill}
            </span>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="mb-4 font-serif text-2xl font-bold text-white">
        Herramientas y metodologías
      </h3>

      <div class="flex flex-wrap gap-3">
        {
          otherSkills.map((skill) => (
            <span
              class="rounded-full border border-neutral/20 bg-[#1c232d]/60 px-5 py-2.5 text-sm font-medium text-white transition hover:border-primary hover:text-primary"
            >
              {skill}
            </span>
          ))
        }
      </div>
    </div>

  </div>
</Section>