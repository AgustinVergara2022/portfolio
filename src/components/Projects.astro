---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Proyectos destacados" href="projects">
  <div class="space-y-16">
    {
      projects.map(
        ({ name, summary, image, technologies, linkPreview, linkSource }, index) => (
          <article
            class:list={[
              "overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/60",
              index === 0 && "border-primary/30",
            ]}
          >
            <div class="grid md:grid-cols-2">
              <div class="flex flex-col p-7 md:p-10">
                {
                  index === 0 && (
                    <span class="mb-4 text-sm font-medium uppercase tracking-widest text-primary">
                      Proyecto principal
                    </span>
                  )
                }

                <h3 class="mb-5 font-serif text-3xl font-bold text-white md:text-4xl">
                  {name}
                </h3>

                <p class="text-base leading-7 text-neutral">
                  {summary}
                </p>

                <div class="mt-7">
                  <p class="mb-3 text-sm font-medium text-white">
                    Tecnologías utilizadas
                  </p>

                  <div class="flex flex-wrap gap-2">
                    {
                      technologies.map((technology) => (
                        <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                          {technology}
                        </span>
                      ))
                    }
                  </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-6">
                  {
                    linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-white hover:text-primary hover:underline"
                      >
                        GitHub ↗
                      </a>
                    )
                  }

                  {
                    linkPreview && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-white hover:text-primary hover:underline"
                      >
                        Ver proyecto ↗
                      </a>
                    )
                  }
                </div>
              </div>

              <div class="relative min-h-72 overflow-hidden bg-black md:min-h-full">
                <Image
                  class="h-full w-full object-cover object-top transition duration-500 hover:scale-105"
                  src={image}
                  alt={`Captura del proyecto ${name}`}
                  width="736"
                  height="483"
                />

                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
              </div>
            </div>
          </article>
        ),
      )
    }
  </div>
</Section>