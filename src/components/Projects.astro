---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Proyectos destacados" href="projects">
  <div class="space-y-16">
    {
      projects.map(
        ({ name, summary, image, technologies, linkPreview, linkSource }, index) => (
          <article
            class:list={[
              "overflow-hidden rounded-2xl border border-neutral/20 bg-[#1c232d]/60",
              index === 0 && "border-primary/30",
            ]}
          >
            <div class="grid md:grid-cols-[0.8fr_1.2fr]">

              <!-- Información del proyecto -->
              <div class="flex flex-col justify-center p-7 md:p-9">
                {
                  index === 0 && (
                    <span class="mb-4 text-sm font-medium uppercase tracking-widest text-primary">
                      Proyecto principal
                    </span>
                  )
                }

                <h3 class="mb-5 font-serif text-3xl font-bold text-white md:text-4xl">
                  {name}
                </h3>

                <p class="text-base leading-7 text-neutral">
                  {summary}
                </p>

                <div class="mt-7">
                  <p class="mb-3 text-sm font-medium text-white">
                    Tecnologías utilizadas
                  </p>

                  <div class="flex flex-wrap gap-2">
                    {
                      technologies.map((technology) => (
                        <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                          {technology}
                        </span>
                      ))
                    }
                  </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-6">
                  {
                    linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-white transition hover:text-primary hover:underline"
                      >
                        GitHub ↗
                      </a>
                    )
                  }

                  {
                    linkPreview && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-white transition hover:text-primary hover:underline"
                      >
                        Ver proyecto ↗
                      </a>
                    )
                  }
                </div>
              </div>

              <!-- Vista previa del proyecto -->
              <div class="relative flex min-h-[420px] items-center justify-center overflow-hidden bg-black p-4 md:min-h-[480px] md:p-5">
                <div class="relative h-full w-full overflow-hidden rounded-xl border border-white/10 bg-[#11161d] shadow-2xl">
                  <Image
                    class="h-full w-full object-cover object-[center_35%] transition duration-500 hover:scale-[1.02]"
                    src={image}
                    alt={`Captura del proyecto ${name}`}
                    width="1200"
                    height="800"
                  />

                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent" />
                </div>
              </div>

            </div>
          </article>
        ),
      )
    }
  </div>
</Section>